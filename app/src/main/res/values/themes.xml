<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.ClientApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_coral</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:colorBackground">@color/mint_background</item>
        <item name="android:statusBarColor">@color/mint_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.ClientApp" parent="Base.Theme.ClientApp" />

    <!-- Style réutilisable pour les cartes inspirées du template -->
    <style name="ModernCardStyle">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardMaxElevation">4dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
</resources>